# URL of the Railway backend (no trailing slash)
VITE_API_URL=https://your-backend.up.railway.app

# Firebase web app config (Project settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Secret path of the admin panel, e.g. ops-7k2m9q4x (at least 6 characters). Leave empty to disable the admin page.
VITE_ADMIN_PATH=
