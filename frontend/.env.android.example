# Copy to .env.android (gitignored) and fill in. Used by `npm run build:android` (vite build --mode android).
VITE_API_URL=https://your-backend.up.railway.app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_PLATFORM=android

# Never set VITE_ADMIN_PATH here: the admin panel is web-only.

# AdMob. Leave empty to use Google's official test IDs.
VITE_ADMOB_APP_ID=
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_INTERSTITIAL_ID=
