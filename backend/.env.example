# ---- Server ----
PORT=8080
NODE_ENV=production
# Comma-separated list of allowed frontend origins (your Vercel domain(s))
FRONTEND_ORIGIN=https://match360.vercel.app
# Public URL of the frontend, used for links inside emails
APP_URL=https://match360.vercel.app

# ---- Database (Railway Postgres provides this automatically) ----
DATABASE_URL=postgresql://user:pass@host:5432/railway

# ---- Firebase Admin (Project settings > Service accounts > Generate new private key) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key with literal \n sequences; they are converted to newlines at runtime
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Cloudflare R2 (photo storage) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=match360-photos
# Public bucket URL or custom domain, e.g. https://pub-xxxx.r2.dev or https://cdn.yourdomain.com
R2_PUBLIC_URL=

# ---- Resend (email notifications) ----
RESEND_API_KEY=
RESEND_FROM="Match360 <notifications@yourdomain.com>"
