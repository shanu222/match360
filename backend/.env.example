# ---- Server ----
PORT=8080
NODE_ENV=production
# Comma-separated list of allowed frontend origins (your Vercel domain(s))
FRONTEND_ORIGIN=https://match360.vercel.app
# Public URL of the frontend, used for links inside emails
APP_URL=https://match360.vercel.app

# ---- Database (Railway Postgres provides this automatically) ----
DATABASE_URL=postgresql://user:pass@host:5432/railway

# ---- Firebase Admin (Project settings > Service accounts > Generate new private key) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key with literal \n sequences; they are converted to newlines at runtime
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Cloudflare R2 (photo storage) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=match360-photos
# Public bucket URL or custom domain, e.g. https://pub-xxxx.r2.dev or https://cdn.yourdomain.com
R2_PUBLIC_URL=

# ---- Resend (email notifications) ----
RESEND_API_KEY=
RESEND_FROM="Match360 <notifications@yourdomain.com>"

# ---- Admin panel (required to enable it; never commit real values) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Long random string. Signs admin sessions and encrypts API keys saved in the admin panel.
# Generate one with: openssl rand -hex 32
ADMIN_SECRET=

# ---- AI question generation (any or none; admin panel can override) ----
AI_PROVIDER_ORDER=openai,gemini,openrouter
AI_TIMEOUT_MS=12000
AI_LOGGING=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
# Comma-separated, tried in order
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ---- Private storage for ID documents and receipts (recommended) ----
# A second R2 bucket with public access DISABLED. Falls back to R2_BUCKET if empty.
R2_PRIVATE_BUCKET=
